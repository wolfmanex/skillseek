# Postgres. On Vercel with the Neon integration both are set for you:
# DATABASE_URL is the pooled connection, DATABASE_URL_UNPOOLED the direct one used for migrations.
DATABASE_URL="postgresql://skillseek:skillseek@localhost:5432/skillseek"
DATABASE_URL_UNPOOLED="postgresql://skillseek:skillseek@localhost:5432/skillseek"

# Public base URL, used in email links (e.g. https://skillseek.vercel.app)
APP_URL="http://localhost:3000"

# Email through Resend (sign-in links and notifications). Without a key, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Skillseek <onboarding@resend.dev>"

# Photo uploads to Cloudflare R2. Leave empty to hide photo uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_JURISDICTION="eu"
# Public URL of the bucket, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=""

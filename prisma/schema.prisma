generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // On Neon, DATABASE_URL is the pooled connection and DATABASE_URL_UNPOOLED the direct one (used for migrations).
  // Both names match what the Neon integration on Vercel sets automatically.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CONTRACTOR
  SUBCONTRACTOR
  SPECIALIST
}

enum Seeking {
  SUBCONTRACTOR
  SPECIALIST
  ANY
}

enum PostingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  DECLINED
}

enum ApplicationSource {
  APPLIED
  INVITED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  isAdmin      Boolean  @default(false)
  locale       String   @default("et")
  createdAt    DateTime @default(now())

  profile        Profile?
  sessions       Session[]
  loginTokens    LoginToken[]
  postings       Posting[]
  applications   Application[]
  messages       Message[]
  reviewsWritten Review[]      @relation("ReviewAuthor")
  reviewsGot     Review[]      @relation("ReviewSubject")
  claimedCompany Company?
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time email sign-in links. Only a hash of the token is stored.
model LoginToken {
  tokenHash String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  displayName      String
  companyName      String?
  regCode          String?
  bio              String    @default("")
  phone            String?
  website          String?
  country          String?
  serviceCountries String[]
  certifications   String[]
  portfolioUrls    String[]
  photoKeys        String[]
  yearsExperience  Int?
  hourlyRate       Int?
  available        Boolean   @default(true)
  availableFrom    DateTime?
  verified         Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]
}

model Trade {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameEn   String
  nameEt   String
  nameFi   String    @default("")
  profiles Profile[]
  postings Posting[]
}

model Posting {
  id            String        @id @default(cuid())
  authorId      String
  title         String
  description   String
  country       String
  city          String?
  startDate     DateTime?
  endDate       DateTime?
  budgetMin     Int?
  budgetMax     Int?
  seeking       Seeking       @default(ANY)
  requiredCerts String[]
  status        PostingStatus @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  trades       Trade[]
  applications Application[]
  reviews      Review[]

  @@index([status, country])
}

model Application {
  id          String            @id @default(cuid())
  postingId   String
  applicantId String
  message     String            @default("")
  status      ApplicationStatus @default(PENDING)
  source      ApplicationSource @default(APPLIED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  posting   Posting   @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicant User      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([postingId, applicantId])
}

model Message {
  id            String    @id @default(cuid())
  applicationId String
  senderId      String
  body          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  postingId String
  authorId  String
  subjectId String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User    @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([postingId, authorId, subjectId])
}

// A firm imported from a public register before it has an account on Skillseek.
// Not shown publicly; an admin sends it a claim link that creates a prefilled account and profile.
model Company {
  id         String    @id @default(cuid())
  regCode    String    @unique
  country    String    @default("EE")
  name       String
  legalForm  String?
  status     String // Register status code: R registered, L in liquidation, N in bankruptcy
  address    String?
  county     String?
  city       String?
  email      String?
  phone      String?
  website    String?
  emtakCodes String[]
  mainEmtak  String?
  tradeSlugs String[]
  foundedAt  DateTime?
  source     String    @default("ariregister")
  importedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Only a hash of the claim token is stored. The same link also lets the firm opt out.
  claimTokenHash      String?   @unique
  claimTokenExpiresAt DateTime?
  // True when the link was emailed to the address in the register, so claiming proves control of it.
  claimVerifies       Boolean   @default(false)
  invitedAt           DateTime?
  invitedEmail        String?
  claimedAt           DateTime?
  claimedById         String?   @unique
  // Set when the firm asks not to be contacted; contact details are wiped and re-imports skip it.
  optedOutAt          DateTime?

  claimedBy User? @relation(fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([country, claimedAt])
}

// Sign-ups from the public landing page for the invite-only beta. Not linked to a User:
// people are invited from here and create their account later.
model WaitlistEntry {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role
  name        String
  companyName String?
  regCode     String?
  phone       String?
  region      String
  trades      String[]
  message     String    @default("")
  locale      String
  source      String?
  invitedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role, region])
}
